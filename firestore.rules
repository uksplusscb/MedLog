rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Basic Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isVerified() {
      return isSignedIn();
    }
    
    function isAdmin() {
      return isSignedIn();
    }

    function isString(val, max) {
      return val is string && val.size() <= max;
    }

    // Collections
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /visits/{visitId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /medicines/{medicineId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();

      match /visits/{visitId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }
    }

    // Support for collection group queries on visits
    match /{path=**}/visits/{visitId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /summary/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /diagnoses/{diagnosisId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /medicineLogs/{logId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /medicineMonthlyData/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /teachers/{teacherId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /studentPermits/{permitId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}

