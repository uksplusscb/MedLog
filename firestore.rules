rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && request.auth.token.email == "uksplus.scb@gmail.com";
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Global Validation Helpers
    function isString(val, max) {
      return val is string && val.size() <= max;
    }

    // Visit validation
    function isValidVisit(data) {
      return data.keys().hasAll(['date', 'studentName', 'complaint', 'createdAt'])
        && isString(data.studentName, 200)
        && isString(data.complaint, 1000)
        && data.createdAt == request.time;
    }

    match /visits/{visitId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidVisit(request.resource.data);
      allow update: if isAdmin() || (isVerified() && request.auth.uid == resource.data.authorId && isValidVisit(request.resource.data));
      allow delete: if isAdmin() || (isVerified() && request.auth.uid == resource.data.authorId);
    }

    // Master Data Validation (Flexible for CSV imports)
    function isValidMasterData(data) {
      return data.keys().hasAll(['name']) 
        && isString(data.name, 500);
    }

    match /medicines/{medicineId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isVerified() && isValidMasterData(request.resource.data));
      allow delete: if isAdmin();
    }

    match /medicineLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isVerified();
    }

    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isVerified() && isValidMasterData(request.resource.data));
      allow delete: if isAdmin();
    }

    match /diagnoses/{diagnosisId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isVerified() && isValidMasterData(request.resource.data));
      allow delete: if isAdmin();
    }
  }
}
